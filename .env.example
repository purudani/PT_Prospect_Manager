# Office365 OAuth2 Configuration
# Follow the setup guide in OFFICE365_OAUTH_SETUP.md

# Azure AD App Registration Details
OFFICE365_CLIENT_ID=your-client-id-here
OFFICE365_CLIENT_SECRET=your-client-secret-here
OFFICE365_TENANT_ID=your-tenant-id-here

# Email address that will send the emails
OFFICE365_USER_EMAIL=your-email@yourdomain.com

# Server Port (optional)
PORT=3001
